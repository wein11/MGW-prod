{
  "info": {
    "name": "mgw-prod",
    "description": "Etapa 1 — colección de defensa del TPO. Cubre los 5 módulos (users, catalog, collab, challenges, billing). Requiere el Environment 'mgw-prod local' (base_url=http://localhost:8080).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080" }
  ],
  "item": [
    {
      "name": "Users",
      "item": [
        {
          "name": "POST /api/auth/register (ARTIST)",
          "event": [{ "listen": "prerequest", "script": { "exec": [
            "pm.variables.set('artistEmailGenerated', 'artist' + Date.now() + '@mgw.test');"
          ] } }, { "listen": "test", "script": { "exec": [
            "const body = pm.response.json();",
            "pm.environment.set('artistUserId', body.id);",
            "pm.environment.set('artistEmail', pm.variables.get('artistEmailGenerated'));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{artistEmailGenerated}}\",\n  \"password\": \"secret123\",\n  \"displayName\": \"Artist Demo\",\n  \"role\": \"ARTIST\",\n  \"city\": \"Buenos Aires\"\n}" },
            "url": { "raw": "{{base_url}}/api/auth/register", "host": ["{{base_url}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
