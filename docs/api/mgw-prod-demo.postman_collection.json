    {
      "name": "2. Beats (CRUD)",
      "item": [
        {
          "name": "Crear beat",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.environment.set(\"beatId\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{artistToken}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/beats",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "beats"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Trap Beat\",\n  \"genre\": \"Trap\",\n  \"bpm\": 140,\n  \"key\": \"Am\",\n  \"audioUrl\": \"https://soundcloud.com/demo/trap-beat\"\n}"
            }
          }
        },
        {
          "name": "Listar beats",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/beats",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "beats"
              ]
            }
          }
        },
        {
          "name": "Editar beat",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{artistToken}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/beats/{{beatId}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "beats",
                "{{beatId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Trap Beat (versión final)\",\n  \"bpm\": 145\n}"
            }
          }
        },
        {
          "name": "Borrar beat",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.sendRequest({",
                  "    url: pm.environment.get(\"base_url\") + \"/api/beats\",",
                  "    method: \"POST\",",
                  "    header: {",
                  "        \"Content-Type\": \"application/json\",",
                  "        \"Authorization\": \"Bearer \" + pm.environment.get(\"artistToken\")",
                  "    },",
                  "    body: {",
                  "        mode: \"raw\",",
                  "        raw: JSON.stringify({ title: \"Beat para borrar\", genre: \"Trap\", bpm: 120, audioUrl: \"https://soundcloud.com/demo/borrar\" })",
                  "    }",
                  "}, function (err, res) {",
                  "    pm.environment.set(\"beatToDeleteId\", res.json().id);",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 204\", function () {",
                  "    pm.response.to.have.status(204);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{artistToken}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/beats/{{beatToDeleteId}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "beats",
                "{{beatToDeleteId}}"
              ]
            }
          }
        }
      ]
